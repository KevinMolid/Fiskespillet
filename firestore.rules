rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      function signedIn() {
        return request.auth != null;
      }

      function owner() {
        return signedIn() && request.auth.uid == uid;
      }

      function validProfile() {
        return request.resource.data.keys().hasAll(['username', 'bio', 'avatar', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['username', 'bio', 'avatar', 'createdAt', 'updatedAt'])
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 24
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 500
          && request.resource.data.avatar is string
          && request.resource.data.avatar.size() <= 100000
          && (request.resource.data.avatar == ''
              || request.resource.data.avatar.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt == request.time;
      }

      allow get, list: if signedIn();
      allow create: if owner()
        && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if owner()
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
  }
}
