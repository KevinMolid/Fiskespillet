rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      function signedIn() {
        return request.auth != null;
      }

      function owner() {
        return signedIn() && request.auth.uid == uid;
      }

      function validProfile() {
        return request.resource.data.keys().hasAll(['username', 'bio', 'avatar', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['username', 'bio', 'avatar', 'createdAt', 'updatedAt'])
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 24
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 500
          && request.resource.data.avatar is string
          && request.resource.data.avatar.size() <= 100000
          && (request.resource.data.avatar == ''
              || request.resource.data.avatar.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt == request.time;
      }

      allow get, list: if signedIn();
      allow create: if owner()
        && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if owner()
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /gameSaves/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validSave() {
        return request.resource.data.keys().hasAll(['mapId', 'x', 'y', 'facing', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['mapId', 'x', 'y', 'facing', 'updatedAt'])
          && request.resource.data.mapId in ['havn', 'skogstjern', 'hjem', 'hjem2', 'butikk']
          && request.resource.data.x is int
          && request.resource.data.x >= 0
          && request.resource.data.x <= 47
          && request.resource.data.y is int
          && request.resource.data.y >= 0
          && request.resource.data.y <= 31
          && request.resource.data.facing in ['up', 'down', 'left', 'right']
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if owner();
      allow create, update: if owner() && validSave();
      allow delete: if owner();
      allow list: if false;
    }

    match /playerInventories/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validCounts(counts) {
        return counts is map
          && counts.keys().hasOnly(['rod', 'shovel', 'worm', 'bread', 'corn', 'spinner', 'sneakers'])
          && counts.get('sneakers', 0) is int
          && counts.get('sneakers', 0) >= 0
          && counts.get('sneakers', 0) <= 1
          && counts.get('rod', 0) is int
          && counts.get('rod', 0) >= 0
          && counts.get('rod', 0) <= 999
          && counts.get('shovel', 0) is int
          && counts.get('shovel', 0) >= 0
          && counts.get('shovel', 0) <= 999
          && counts.get('worm', 0) is int
          && counts.get('worm', 0) >= 0
          && counts.get('worm', 0) <= 999
          && counts.get('bread', 0) is int
          && counts.get('bread', 0) >= 0
          && counts.get('bread', 0) <= 999
          && counts.get('corn', 0) is int
          && counts.get('corn', 0) >= 0
          && counts.get('corn', 0) <= 999
          && counts.get('spinner', 0) is int
          && counts.get('spinner', 0) >= 0
          && counts.get('spinner', 0) <= 999;
      }

      function validInventory() {
        return request.resource.data.keys().hasAll(['bag', 'storage', 'equippedBait', 'coins', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['bag', 'storage', 'equippedBait', 'coins', 'updatedAt'])
          && validCounts(request.resource.data.bag)
          && validCounts(request.resource.data.storage)
          && request.resource.data.storage.get('sneakers', 0) == 0
          && request.resource.data.coins is int
          && request.resource.data.coins >= 0
          && request.resource.data.coins <= 1000000
          && (request.resource.data.equippedBait == null
            || (request.resource.data.equippedBait in ['worm', 'bread', 'corn', 'spinner']
              && request.resource.data.bag.get(request.resource.data.equippedBait, 0) > 0))
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if owner();
      allow create: if owner() && validInventory() && request.resource.data.coins == 60
        && request.resource.data.bag.get('sneakers', 0) == 0;
      allow update: if owner() && validInventory()
        && request.resource.data.bag.get('sneakers', 0) >= resource.data.bag.get('sneakers', 0);
      allow delete: if owner();
      allow list: if false;
    }

    match /digSpots/{uid}/entries/{spotId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validSpot() {
        return spotId in [
          'havn_3_17', 'havn_6_19', 'havn_15_20',
          'skogstjern_5_20', 'skogstjern_13_26', 'skogstjern_44_23'
        ] && request.resource.data.keys().hasAll(['lastDugAt'])
          && request.resource.data.keys().hasOnly(['lastDugAt'])
          && request.resource.data.lastDugAt == request.time;
      }

      allow get: if owner();
      allow create: if owner() && validSpot();
      allow update: if owner() && validSpot()
        && request.time >= resource.data.lastDugAt + duration.value(2, 'm');
      allow delete: if owner();
      allow list: if false;
    }

    match /characterLooks/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validLook() {
        return request.resource.data.keys().hasAll(['shirt', 'hair', 'skin', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['shirt', 'hair', 'skin', 'playerVariant', 'updatedAt'])
          && (!('playerVariant' in request.resource.data) || request.resource.data.playerVariant in ['male', 'female'])
          && request.resource.data.shirt is int && request.resource.data.shirt >= 0 && request.resource.data.shirt < 5
          && request.resource.data.hair is int && request.resource.data.hair >= 0 && request.resource.data.hair < 5
          && request.resource.data.skin is int && request.resource.data.skin >= 0 && request.resource.data.skin < 4
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if request.auth != null;
      allow create, update: if owner() && validLook();
      allow delete: if owner();
      allow list: if false;
    }

    match /fishBooks/{uid}/entries/{speciesId} {
      function signedIn() {
        return request.auth != null;
      }

      function owner() {
        return signedIn() && request.auth.uid == uid;
      }

      function validEntry() {
        return speciesId in ['makrell', 'sei', 'torsk', 'orret', 'abbor', 'lyr', 'sjoorret', 'gjedde', 'roye', 'sild', 'hvitting', 'rodspette', 'harr', 'sik', 'laks', 'brosme', 'lange', 'gjors', 'kveite', 'steinbit', 'mort', 'gullorret']
          && request.resource.data.keys().hasAll([
            'speciesId', 'seenCount', 'caughtCount', 'smallestGrams',
            'largestGrams', 'lastGrams', 'firstSeenAt', 'firstCaughtAt', 'updatedAt',
            'hasCaught', 'discoveredLocationIds', 'seenLocationIds'
          ])
          && request.resource.data.keys().hasOnly([
            'speciesId', 'seenCount', 'caughtCount', 'smallestGrams',
            'largestGrams', 'lastGrams', 'firstSeenAt', 'firstCaughtAt', 'updatedAt',
            'hasCaught', 'discoveredLocationIds', 'seenLocationIds'
          ])
          && request.resource.data.hasCaught == (request.resource.data.caughtCount > 0)
          && request.resource.data.discoveredLocationIds is list
          && request.resource.data.discoveredLocationIds.hasOnly(['havn', 'skogstjern'])
          && request.resource.data.discoveredLocationIds.size() == request.resource.data.discoveredLocationIds.toSet().size()
          && (request.resource.data.hasCaught || request.resource.data.discoveredLocationIds.size() == 0)
          && request.resource.data.seenLocationIds is list
          && request.resource.data.seenLocationIds.hasOnly(['havn', 'skogstjern'])
          && request.resource.data.seenLocationIds.size() == request.resource.data.seenLocationIds.toSet().size()
          && request.resource.data.seenLocationIds.hasAll(request.resource.data.discoveredLocationIds)
          && request.resource.data.speciesId == speciesId
          && request.resource.data.seenCount is int
          && request.resource.data.seenCount >= 1
          && request.resource.data.caughtCount is int
          && request.resource.data.caughtCount >= 0
          && request.resource.data.caughtCount <= request.resource.data.seenCount
          && request.resource.data.firstSeenAt is timestamp
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.caughtCount == 0
              && request.resource.data.smallestGrams == null
              && request.resource.data.largestGrams == null
              && request.resource.data.lastGrams == null
              && request.resource.data.firstCaughtAt == null)
            || (request.resource.data.caughtCount > 0
              && request.resource.data.smallestGrams is int
              && request.resource.data.largestGrams is int
              && request.resource.data.lastGrams is int
              && request.resource.data.smallestGrams >= 1
              && request.resource.data.smallestGrams <= request.resource.data.lastGrams
              && request.resource.data.lastGrams <= request.resource.data.largestGrams
              && request.resource.data.largestGrams <= 240000
              && request.resource.data.firstCaughtAt is timestamp)
          );
      }

      // Existing documents have no locations: preserve records and upgrade lazily.
      function validProgress() {
        let old = resource.data;
        let next = request.resource.data;
        let locations = old.get('discoveredLocationIds', []);
        // Historical caught locations count as seen; older records have no separate seen list.
        let seenLocations = old.get('seenLocationIds', locations);
        let caught = next.caughtCount == old.caughtCount + 1;
        return next.discoveredLocationIds.hasAll(locations)
          && next.seenLocationIds.hasAll(seenLocations)
          && next.seenLocationIds.size() <= seenLocations.size() + 1
          && (caught
            ? (next.discoveredLocationIds.size() >= 1
              && next.discoveredLocationIds.size() <= locations.size() + 1
              && next.smallestGrams == (old.caughtCount == 0 || next.lastGrams < old.smallestGrams ? next.lastGrams : old.smallestGrams)
              && next.largestGrams == (old.caughtCount == 0 || next.lastGrams > old.largestGrams ? next.lastGrams : old.largestGrams))
            : (next.discoveredLocationIds == locations
              && next.seenLocationIds.size() >= seenLocations.size()
              && next.smallestGrams == old.smallestGrams
              && next.largestGrams == old.largestGrams
              && next.lastGrams == old.lastGrams));
      }

      allow get, list: if signedIn();
      allow create: if owner() && validEntry()
        && request.resource.data.seenCount == 1
        && request.resource.data.caughtCount <= 1
        && request.resource.data.discoveredLocationIds.size() == request.resource.data.caughtCount
        && request.resource.data.seenLocationIds.size() == 1
        && request.resource.data.smallestGrams == request.resource.data.lastGrams
        && request.resource.data.largestGrams == request.resource.data.lastGrams
        && request.resource.data.firstSeenAt == request.time
        && (request.resource.data.firstCaughtAt == null || request.resource.data.firstCaughtAt == request.time);
      allow update: if owner() && validEntry() && validProgress()
        && request.resource.data.seenCount == resource.data.seenCount + 1
        && request.resource.data.caughtCount >= resource.data.caughtCount
        && request.resource.data.caughtCount <= resource.data.caughtCount + 1
        && request.resource.data.firstSeenAt == resource.data.firstSeenAt
        && (request.resource.data.firstCaughtAt == resource.data.firstCaughtAt
          || (resource.data.firstCaughtAt == null && request.resource.data.firstCaughtAt == request.time));
      allow delete: if owner();
    }
  }
}
